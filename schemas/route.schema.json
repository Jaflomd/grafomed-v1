{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaflo.local/grafomed/route.schema.json",
  "title": "Grafo Med route",
  "type": "object",
  "required": ["schema", "id", "label", "goal", "route_kind", "status", "snapshot_id", "target_refs", "steps", "provenance"],
  "properties": {
    "schema": {"const": "grafomed-route.v1"},
    "id": {"type": "string", "pattern": "^gm-route-[a-z0-9-]+$"},
    "label": {"type": "string"},
    "goal": {"type": "string"},
    "route_kind": {"enum": ["manual_gold", "generated", "remediation", "transfer"]},
    "status": {"enum": ["candidate", "route_tested", "promoted"]},
    "snapshot_id": {"type": "string", "minLength": 8},
    "target_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "node_id", "kind", "reason"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "node_id": {"type": "string"},
          "kind": {"enum": ["orient", "learn", "retrieve", "apply", "decide", "assess", "transfer", "remediate"]},
          "reason": {"type": "string", "minLength": 5}
        },
        "additionalProperties": true
      }
    },
    "provenance": {"type": "object", "required": ["created_by", "created_at", "packet_id", "algorithm"]}
  },
  "additionalProperties": true
}

